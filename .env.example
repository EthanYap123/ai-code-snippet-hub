# Postgres with the pgvector extension (e.g. a Neon connection string).
# Leave empty to use the embedded PGlite database stored in ./.data/pglite.
DATABASE_URL=

# Google Gemini API key. Leave empty to run the offline engine
# (heuristic docs + local hashed embeddings) with no network calls.
GEMINI_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini            # gemini | local (defaults to gemini when a key is set)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Protects GET/POST /api/worker when called by a scheduler.
# CRON_SECRET=

# Max snippets one visitor can submit per hour (0 disables the limit).
# SUBMIT_LIMIT_PER_HOUR=15
